{
  "paths": {
    "experiment_dir": "./experiments/gaussian_noise",
    "experiment_path": null
  },
  "model": {
    "num_layers": 1,
    "hidden_size": 16,
    "dropout": 0,
    "input_size": 1,
    "output_size": 1
  },
  "training": {
    "epochs": 10000,
    "batch_size": 50,
    "learning_rate": 0.007,
    "trials_per_epoch": 1000,
    "validation_trials": 100,
    "checkpoint_best_only": true,
    "optimizer": "adam",
    "use_scheduler": false,
    "scheduler": {
      "increase_factor": 1.1,
      "decrease_factor": 0.9,
      "still_factor": 1.05,
      "max_lr": 0.1,
      "min_lr": 1e-07,
      "patience_up": 3,
      "patience_down": 7,
      "patience_still": 10,
      "threshold": 0.01,
      "verbose": true
    }
  },
  "task": {
    "min_period": 0.5,
    "max_period": 0.5,
    "n_pulses": 5,
    "pulse_height": 1,
    "pulse_width": 0.01,
    "dt": 0.01,
    "sequence_length": 5.0,
    "baseline_value": 0.0,
    "min_iti": 0.7,
    "mean_iti": 2.0,
    "target_type": "gaussian_noise",
    "output_offset": -0.5,
    "skip_first_n": 0,
    "ignore_tail_error": true,
    "gamma_params": {
      "gamma_length": 0.2,
      "gamma_shape": 1.75,
      "gamma_max_height": 0.1
    },
    "gaussian_params": {
      "gaussian_length": 0.03,
      "gaussian_sigma": null,
      "gaussian_max_height": 0.3
    },
    "noise_params": {
      "phase_noise_std": 0.02,
      "jitter_std": 0.01,
      "min_n_pulses": 4,
      "max_n_pulses": 7,
      "random_start_offset": true
    }
  },
  "logging": {
    "tensorboard": true,
    "log_interval": 10,
    "save_interval": 10
  },
  "testing": {
    "n_test_periods": 10,
    "test_trials_per_period": 5
  },
  "seed": 42
}