{
  "paths": {
    "experiment_dir": "./experiments/sync_continuation",
    "experiment_path": null
  },
  "model": {
    "num_layers": 1,
    "hidden_size": 16,
    "dropout": 0,
    "input_size": 1,
    "output_size": 1
  },
  "training": {
    "epochs": 10000,
    "batch_size": 50,
    "learning_rate": 0.007,
    "trials_per_epoch": 1000,
    "validation_trials": 100,
    "checkpoint_best_only": true,
    "optimizer": "adam",
    "use_scheduler": false
  },
  "task": {
    "task_type": "sync_continuation",

    "min_period": 0.450,
    "max_period": 0.850,
    "period_step": 0.100,

    "attention_phase": {
      "min_n_pulses": 1,
      "max_n_pulses": 4
    },
    "sync_phase": {
      "min_n_pulses": 5,
      "max_n_pulses": 6
    },
    "continuation_phase": {
      "min_n_pulses": 3,
      "max_n_pulses": 5
    },

    "target_shape": "gaussian",

    "pulse_width": 0.05,
    "pulse_height": 1.0,
    "dt": 0.01,
    "sequence_length": 11.0,
    "baseline_value": 0.0,
    "output_offset": 0.0,

    "noise_params": {
      "phase_noise_std": 0.0,
      "jitter_std": 0.0
    },

    "gaussian_params": {
      "gaussian_length": 0.05,
      "gaussian_sigma": null,
      "gaussian_max_height": 0.3
    },

    "skip_first_n_sync": 1,
    "ignore_attention_error": false,
    "ignore_tail_error": true,
    "ignore_skipped_sync_error": true
  },
  "logging": {
    "tensorboard": true,
    "log_interval": 10,
    "save_interval": 100
  },
  "testing": {
    "n_test_periods": 9,
    "test_trials_per_period": 5,
    "test_period_step": 0.050
  },
  "feedback": {
    "enabled": true,
    "threshold": 0.1,
    "delay": 0.05,
    "pulse_shape": "rectangular",
    "pulse_width": 0.05,
    "pulse_height": 1.0,
    "refractory_period": 0.05,
    "continuation_decay": 0.7
  },
  "seed": 42
}