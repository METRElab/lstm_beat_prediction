{
  "paths": {
    "experiment_dir": "./experiments",
    "experiment_path": null
  },
  "model": {
    "num_layers": 1,
    "hidden_size": 16,
    "dropout": 0,
    "input_size": 1,
    "output_size": 1
  },
  "training": {
    "epochs": 10000,
    "batch_size": 50,
    "learning_rate": 0.007,
    "trials_per_epoch": 1000,
    "validation_trials": 100,
    "checkpoint_best_only": true,
    "optimizer": "adam"
  },
  "task": {
    "min_period": 0.4,
    "max_period": 0.8,
    "n_pulses": 5,
    "pulse_height": 0.5,
    "pulse_width": 0.01,
    "dt": 0.001,
    "sequence_length": 7.0,
    "baseline_value": 0.0,
    "min_iti": 0.7,
    "mean_iti": 2.0,
    "target_type": "gamma",
    "output_offset": -0.5,
    "skip_first_n": 2,
    "gamma_params": {
      "gamma_length": 0.2,
      "gamma_shape": 1.75,
      "gamma_max_height": 0.1
    }
  },
  "logging": {
    "tensorboard": true,
    "log_interval": 10,
    "save_interval": 10
  },
  "testing": {
    "n_test_periods": 10,
    "test_trials_per_period": 5
  },
  "seed": 42
}